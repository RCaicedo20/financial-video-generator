# Create .env by copying this file. Never commit actual keys.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000

# true = local visual demo (no narration, no external APIs)
DEMO_MODE=true

# Only needed when DEMO_MODE=false. Client supplies OpenAI API key PER REQUEST.
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
GENERATE_MUSIC=false

# Hard video constraints
MAX_VIDEO_SECONDS=180
VIDEO_FPS=30
