# API server
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Sherpaswealth LLM proxy
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Start with LLM-generated visuals, without paid audio
DEMO_MODE=false
AUDIO_MODE=proxy
PROXY_TTS_MODEL=eleven-flash-v2.5
PROXY_TTS_VOICE=alloy
GENERATE_MUSIC=true
MUSIC_FILE=assets/background-music.mp3

# Video
MAX_VIDEO_SECONDS=180
VIDEO_FPS=30